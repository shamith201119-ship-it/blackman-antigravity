# Groq API Configuration (Free tier: https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Cloudinary Configuration (Free tier: https://cloudinary.com)
# You can provide the full CLOUDINARY_URL or individual credentials
CLOUDINARY_URL=cloudinary://<API_KEY>:<API_SECRET>@<CLOUD_NAME>
# OR discrete keys:
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Meta Instagram Graph API Configuration
# Requires an Instagram Professional/Business account connected to a Facebook Page
IG_USER_ID=your_instagram_business_account_id
IG_ACCESS_TOKEN=your_long_lived_meta_graph_api_access_token

# Execution flags (set to true to test locally without calling external APIs)
DRY_RUN=false
